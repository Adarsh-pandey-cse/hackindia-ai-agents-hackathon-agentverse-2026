# Grounded Document QA App - Environment Configuration
# Optional: Set your OpenAI or Gemini API key if using live LLM generation
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# RAG Configuration
RAG_DATA_DIR=data/sample_docs
RAG_CHUNKS_PATH=data/chunks.json
RAG_SIMILARITY_THRESHOLD=0.22
RAG_TOP_K=3

# Docker & Database Configuration (HackIndia Docker Skill)
APP_PORT=3000
DATABASE_URL=postgres://app_user:app_password@db:5432/app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app_db
JWT_SECRET=change_me_for_local_testing
