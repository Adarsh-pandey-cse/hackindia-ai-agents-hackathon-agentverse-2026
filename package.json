{
  "name": "hackindia-agentverse-2026",
  "version": "1.0.0",
  "description": "AgentVerse Autonomous AI Agent, ML Pipeline & JavaScript Engine for HackIndia 2026",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "python web_app.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/index.js",
    "test": "node --test tests/test_agent.js tests/test_express_api.js tests/test_react_app.js tests/test_full_stack.js tests/test_nextjs_app_router.js tests/test_api_design.js tests/test_sql_feature.js",
    "test:api": "node --test tests/test_express_api.js",
    "test:react": "node --test tests/test_react_app.js",
    "cli": "node src/agent_cli.js",
    "verify:system-design": "python verify_system_design.py",
    "verify:express": "python verify_express_api.py",
    "verify:react": "python verify_react_app.py",
    "fullstack": "node server/index.js",
    "test:fullstack": "node --test tests/test_full_stack.js",
    "verify:fullstack": "python verify_full_stack_repo.py",
    "next:dev": "next dev",
    "verify:nextjs": "python verify_nextjs_app_router.py",
    "test:nextjs": "node --test tests/test_nextjs_app_router.js",
    "verify:api-design": "python verify_api_design.py",
    "smoke": "python scripts/smoke.py",
    "verify:sql": "python verify_sql_feature.py",
    "db:init": "python scripts/init_db.py"
  },
  "keywords": [
    "hackindia",
    "javascript",
    "ai-agents",
    "machine-learning",
    "scikit-learn"
